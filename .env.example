# Copy to .env and fill in. Never commit .env.

# Chat model, as provider:model. Examples:
#   openai:gpt-4o-mini
#   anthropic:claude-haiku-4-5
#   openrouter:openai/gpt-4o-mini   (any model id from openrouter.ai)
TRIAGE_MODEL=openai:gpt-4o-mini
# Model for the LLM judge (can be the same)
JUDGE_MODEL=openai:gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Langfuse Cloud (https://cloud.langfuse.com). Leave blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU projects: https://cloud.langfuse.com   US projects: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: a GitHub token raises the API rate limit when fetching issues.
GITHUB_TOKEN=

# Repository whose issues are triaged (read-only; the agent never writes to it).
TRIAGE_REPO=Arize-ai/phoenix
